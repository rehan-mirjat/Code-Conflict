# Code & Conflict Backend Environment Configuration
# Copy this file to .env or export these variables in your environment.

# Port for Flask application server
PORT=5000

# Secret key for cryptographically signing session cookies.
# If omitted, a persistent 32-byte secret key will be generated into backend/.secret_key
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database file path (defaults to backend/data.db)
CC_DB=backend/data.db

# Enforce secure cookies (set to true in production over HTTPS)
COOKIE_SECURE=false
